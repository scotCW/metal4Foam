# wmake build artifacts (OpenFOAM convention)
lnInclude/
**/Make/linux*/
**/Make/darwin*/
platforms/
build/

# Object, dependency and library artifacts - anywhere
*.o
*.dep
*.so
*.dylib
*.metallib

# Generated: embedded MSL source header (Allwmake step 1, rebuilt from
# src/metal4Foam/shaders/metalFoamKernels.metal every build)
src/metal4Foam/backend/metalFoamKernelsMSL.H

# Editor / OS cruft
*~
.*.swp
.DS_Store
.vscode/
.idea/

# sed -i.bak backups (benchmark/run_case.sh edits fvSolution/controlDict in place)
*.bak

# Benchmark case runs and result logs (regenerated by benchmark/run_all.sh)
benchmark/runs/
benchmark/results_*.txt

# Core dumps
core
